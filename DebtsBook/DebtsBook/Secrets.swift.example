import Foundation

// Copy this file to Secrets.swift (git-ignored) and fill in each Supabase project's
// values from Project Settings > API in the Supabase dashboard.
//
// Debug builds (Xcode, simulators) talk to the staging project, so experiments and
// new migrations never touch real users. Release builds (TestFlight, App Store) use
// production.
enum Secrets {
    #if DEBUG
    static let supabaseURL = URL(string: "https://YOUR_STAGING_PROJECT_REF.supabase.co")!
    static let supabaseAnonKey = "YOUR_STAGING_ANON_KEY"
    #else
    static let supabaseURL = URL(string: "https://YOUR_PRODUCTION_PROJECT_REF.supabase.co")!
    static let supabaseAnonKey = "YOUR_PRODUCTION_ANON_KEY"
    #endif
}
